{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "email": {
        "type": "string",
        "format": "email"
      },
      "fullName": {
        "type": "string"
      },
      "assetConfiguration": {
        "type": "object"
      }
    },
    "required": [
      "name",
      "id",
      "email",
      "fullName",
      "assetConfiguration"
    ]
  }
}